  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TaskStepManager
  steps:
  - step: 1
    instructionText: '"Welcome! We will bake a cake in this XR kitchen."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 661926754}
  - step: 2
    instructionText: '"Gather flour, eggs and sugar from the counter." '
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 64780006}
  - step: 3
    instructionText: '"Crack the eggs into the mixing bowl."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 29861271}
  - step: 4
    instructionText: '"Add flour to the bowl."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 29861271}
  - step: 7
    instructionText: '"Mix the ingredients until smooth."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 29861271}
  - step: 5
    instructionText: '"Mix the ingredients until smooth."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors: []
  - step: 6
    instructionText: '"Preheat the oven and place the tray inside."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 777543806}
  - step: 8
    instructionText: '"Bake the cake until it is golden brown."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 777543806}
  - step: 9
    instructionText: '"Great job! You have finished baking the cake."'
    optionalClip: {fileID: 0}
    clipStartTime: 0
    clipDuration: 0
    semanticAnchors:
    - {fileID: 64780006}
  initialStep: 1
